# Copiá este archivo a .env y completá los valores.
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux / macOS)
#
# El archivo .env NO se versiona: está en .gitignore.

# Clave privada de Mercado Pago (empieza por APP_USR-). Sin ella se usa
# el simulador local.
MP_ACCESS_TOKEN=APP_USR-598abc22-6687-48cd-9be2-693a29f5c982

# Raíz de la API (valor por defecto salvo que uses un mock).
MP_API_URL=https://api.mercadopago.com

# Segundos de espera por llamada a la API.
MP_TIMEOUT=10

# Raíz pública del sitio para las back_urls.
MP_BASE_URL=http://127.0.0.1:5000

# URL pública del webhook (vacía en local).
MP_NOTIFICATION_URL=

# Moneda de la preferencia (Mercado Pago no acepta EUR).
MP_CURRENCY=ARS

# Clave secreta de Flask (en desarrollo puede quedar vacía).
SECRET_KEY=
